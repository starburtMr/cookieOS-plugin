        "pinyin-pro": "^3.13.0",
        "nzh": "^1.0.13",
        "mathjs": "15.2.0",
        "chardet": "^2.0.0",
        "text-decoding": "^1.0.0",
        "bs58": "^6.0.0",
        "crc": "^4.2.0",
