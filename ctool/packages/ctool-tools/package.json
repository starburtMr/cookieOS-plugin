{
    "name": "ctool-tools",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "default": "./src/index.ts"
        },
        "./domains/*": {
            "types": "./dist/types/domains/*.d.ts",
            "default": "./src/domains/*.ts"
        },
        "./asn1/*": {
            "types": "./dist/types/domains/asn1/*.d.ts",
            "default": "./src/domains/asn1/*.js"
        },
        "./adapters/*": {
            "types": "./dist/types/adapters/*.d.ts",
            "default": "./src/adapters/*.ts"
        }
    },
    "dependencies": {
        "@ltd/j-toml": "1.38.0",
